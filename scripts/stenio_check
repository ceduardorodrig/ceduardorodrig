#!/bin/bash
# StênioSentinel (Rust v3.0) — Ponto de entrada para validação de currículos.
# Executa a suíte de auditoria e consistência de CVs com velocidade nativa Rust.
#
# Uso: ./scripts/stenio_check [--fix] [--self-test] [--list]

# Localiza o binário stenio (PATH ou cargo bin)
if command -v stenio >/dev/null 2>&1; then
    STENIO_BIN="stenio"
elif [ -x "$HOME/.cargo/bin/stenio" ]; then
    STENIO_BIN="$HOME/.cargo/bin/stenio"
else
    echo "Erro: binário stenio não encontrado no PATH nem em ~/.cargo/bin/stenio."
    echo "Compile em /mnt/NVME_PCI/agentic-ai/governance/stenio com: cargo build --release"
    exit 1
fi

CMD="$1"
shift 2>/dev/null || true

case "$CMD" in
    --self-test)
        "$STENIO_BIN" --self-test "$@"
        ;;
    --fix)
        "$STENIO_BIN" --fix --scope vault --path "$(pwd)" "$@"
        ;;
    --list)
        "$STENIO_BIN" --list-rules "$@"
        ;;
    --health)
        "$STENIO_BIN" --health "$@"
        ;;
    "")
        "$STENIO_BIN" --scope vault --path "$(pwd)" "$@"
        ;;
    *)
        "$STENIO_BIN" "$CMD" "$@"
        ;;
esac
